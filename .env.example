# Copy to .env and fill in. docker compose reads this file for the app container.
# Never commit the filled-in version.

# ---------------------------------------------------------------- service
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true
# Comma separated host allowlist for the Host header. * disables the check.
TRUSTED_HOSTS=*
# Mounts POST /debug/echo and POST /debug/knowledge. Refused when ENVIRONMENT=production.
DEBUG_ENDPOINTS=true

# ---------------------------------------------------------------- whatsapp
# Meta app secret, used to verify the X-Hub-Signature-256 header.
WHATSAPP_APP_SECRET=
# Token you choose when pointing Meta at the webhook; echoed back during the handshake.
WHATSAPP_VERIFY_TOKEN=
# System user token with whatsapp_business_messaging scope.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_SIGNATURE_REQUIRED=true
# Replies with the inbound text, to prove the outbound path works. Keep false otherwise.
WHATSAPP_ECHO_MODE=false

# ---------------------------------------------------------------- outbound http
HTTP_TIMEOUT_SECONDS=15
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_MAX_CONNECTIONS=50
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_CONNECT_RETRIES=2
OUTBOUND_MAX_ATTEMPTS=4
OUTBOUND_RETRY_BASE_DELAY_SECONDS=0.5
OUTBOUND_RETRY_MAX_DELAY_SECONDS=8

# ---------------------------------------------------------------- background tasks
BACKGROUND_MAX_CONCURRENCY=8
BACKGROUND_DRAIN_TIMEOUT_SECONDS=20
MESSAGE_DEDUPE_TTL_SECONDS=900
MESSAGE_DEDUPE_MAX_ENTRIES=20000

# ---------------------------------------------------------------- ai / llm tiers
# Master switch. /readyz reports not-ready when it is on and no provider is usable.
AI_ENABLED=true
AI_SYSTEM_PROMPT=
AI_REQUEST_TIMEOUT_SECONDS=45
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024
AI_MAX_TOOL_ROUNDS=3
AI_MAX_TOOL_CALLS_PER_RESPONSE=4
AI_TOOL_CALL_TIMEOUT_SECONDS=10
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RECOVERY_SECONDS=30
AI_CIRCUIT_HALF_OPEN_CALLS=1

# Tier 1: Groq (OpenAI-compatible). Set the key to enable.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Tier 2: Google Gemini. Set the key to enable.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash

# Tier 3: any OpenAI-compatible endpoint. Defaults to the local ollama container, which is
# opt-in via `docker compose --profile ollama up`. Set TIER3_ENABLED=true to use it.
TIER3_BASE_URL=http://ollama:11434/v1
TIER3_API_KEY=
TIER3_MODEL=llama3.2
TIER3_ENABLED=false
# Some OpenAI-compatible servers (incl. ollama) retry on their own; leave true to avoid
# double retries.
TIER3_OWNS_RETRY=true

# ---------------------------------------------------------------- embeddings + rag
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_CACHE_DIR=/var/cache/limbot/embeddings
EMBEDDING_BATCH_SIZE=32

RAG_ENABLED=true
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.35
RAG_MAX_CONTEXT_CHARS=6000
# How course material is split on ingest. Overlap must stay below the chunk size.
KNOWLEDGE_CHUNK_CHARS=900
KNOWLEDGE_CHUNK_OVERLAP=150

# ---------------------------------------------------------------- qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=5
QDRANT_COLLECTION=limbot_knowledge
# Make /readyz fail while Qdrant is unreachable. Leave false for a tolerant dev stack.
QDRANT_REQUIRED=false

# ---------------------------------------------------------------- postgres
# Student data. The bot connects read only; schema.sql + seed.sql are applied on first boot.
POSTGRES_DSN=postgresql://limbot:limbot@postgres:5432/limbot
POSTGRES_PASSWORD=limbot
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=5
POSTGRES_COMMAND_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------- conversation memory
CONVERSATION_MAX_MESSAGES=16
CONVERSATION_TTL_SECONDS=1800
CONVERSATION_MAX_CONVERSATIONS=500

# ---------------------------------------------------------------- observability
# Interface the published ports bind to. Use 0.0.0.0 to expose on the LAN.
BIND_ADDRESS=127.0.0.1
GRAFANA_ADMIN_PASSWORD=limbot
PROMETHEUS_RETENTION=15d
# How long Alertmanager keeps silences and its notification log. Silences are how a planned
# deploy is kept from paging, so this must outlive a container restart.
ALERTMANAGER_RETENTION=120h

# ---------------------------------------------------------------- alert destinations
# Alertmanager does not expand environment variables in its config file, so the config is rendered
# from monitoring/alertmanager/alertmanager.yml.template at container start by render-config.sh.
# Set the variables here and no destination is ever committed; that is the point, since a webhook
# URL or SMTP password in version control is a leak that survives every "delete this file".
#
# Every one of these may be left empty. Unset values render to reserved placeholders
# (example.invalid, and the IANA discard port 127.0.0.1:9) that cannot deliver anywhere, so an
# unwired deployment starts, evaluates alerts, and discards them rather than paging a stranger.
# render-config.sh logs a WARNING on every start while the placeholders are still in place, which
# is the only clue you get that alerts are going nowhere.

# Generic webhook receiver: the full incoming-webhook URL from your alerting provider. Alertmanager
# posts its own JSON envelope, so this suits Slack incoming webhooks, PagerDuty, Opsgenie or a
# generic webhook receiver. A provider that expects a bare message body will show raw JSON, which
# is ugly but not wrong. Defaults to the IANA discard port, so it cannot deliver anywhere.
ALERT_WEBHOOK_URL=

# Email. smtp_auth_username and smtp_auth_password are only needed when the relay requires auth,
# so leave both blank for an open relay on localhost. A password containing a space, $, # or & is
# safe: render-config.sh substitutes values verbatim and never re-interprets them.
SMTP_SMARTHOST=
SMTP_FROM=
SMTP_TO=
SMTP_HELLO=limbot-alertmanager
SMTP_AUTH_USERNAME=
SMTP_AUTH_PASSWORD=

# Which substitution engine render-config.sh uses: auto, envsubst or awk. "auto" prefers envsubst
# and falls back to awk; the Prometheus images are busybox-based and busybox does not ship envsubst,
# so inside the container this is normally awk. The two produce the same config, and the test suite
# renders with both and compares, so overriding this is only useful when debugging a divergence.
ALERTMANAGER_RENDERER=auto